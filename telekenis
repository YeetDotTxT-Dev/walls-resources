local function createSettingInput(name, defaultVal, tooltipText, callback)
    local frame = make("Frame", {
        Size = UDim2.new(1, -12, 0, 24),
        Position = UDim2.new(0, 6, 0, nextCfgY(24)),
        BackgroundColor3 = C.row,
        BorderColor3 = C.border,
        BorderSizePixel = 1,
    }, SettingsConfigContent)

    make("TextLabel", {
        Size = UDim2.new(0.65, -10, 1, 0),
        Position = UDim2.new(0, 6, 0, 0),
        BackgroundTransparency = 1,
        Text = "> " .. name,
        TextColor3 = C.text,
        Font = Enum.Font.Code,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    local Box = make("TextBox", {
        Size = UDim2.new(0.32, -4, 1, -4),
        Position = UDim2.new(0.68, 0, 0, 2),
        BackgroundColor3 = C.field,
        BorderColor3 = C.border,
        BorderSizePixel = 1,
        Text = tostring(defaultVal),
        TextColor3 = C.accent,
        Font = Enum.Font.Code,
        TextSize = 11,
        ClearTextOnFocus = false,
    }, frame)

    Box.FocusLost:Connect(function()
        local num = tonumber(Box.Text)
        if num then
            callback(num)
        else
            Box.Text = tostring(defaultVal)
        end
    end)

    bindTooltip(frame, tooltipText)
end

