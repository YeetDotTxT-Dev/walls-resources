local function releaseObject()
    mousedown = false
    BP.Parent = nil
    LaserPart.Parent = nil
    ObjectHighlight.Adornee = nil
    ObjectHighlight.Enabled = false
    TargetHighlight.Adornee = nil
    TargetHighlight.Enabled = false

    if lockGyro then lockGyro:Destroy() lockGyro = nil end
    lockActive = false
    if spinAV then spinAV:Destroy() spinAV = nil end
    spinActive = false
    frozenRoot = nil
    recalling = false

    if object then
        if NoclipModes[Config.NoclipModeIndex] == "UPON HOLD" then
            setAssemblyCollision(object, true)
        end
    end
    object = nil
    updateStatus()
end

---------------------------------------------------------
-- CORE ACTIONS
---------------------------------------------------------
local function applyForceToRoot(part, velocity, flightDuration)
    if not part then return end
    local root = part.AssemblyRootPart or part
    root.Anchored = false
    pcall(function()
        root.CustomPhysicalProperties = PhysicalProperties.new(100, 0.5, 0.1, 1, 1)
    end)
    applyThrowPhase(root, flightDuration or 2.5)
    root.AssemblyLinearVelocity = velocity
    root.AssemblyAngularVelocity = Vector3.new(math.random(-15, 15), math.random(-15, 15), math.random(-15, 15))
    pcall(function() root.Velocity = velocity end)
end

local function throwObject(force)
    if not object or not object.Parent then return end
    local targetObj = object
    local mousePos = UserInputService:GetMouseLocation()
    local ray = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
    releaseObject()
    applyForceToRoot(targetObj, ray.Direction * force, 2.5)
end

local function snipePlayer()
    if not object or not object.Parent then return end

    local targetChar = getHoveredPlayer()
    local targetPart = targetChar and (targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Head"))
    local targetPos = nil
    if not targetPart then
        local mousePos = UserInputService:GetMouseLocation()
        local ray = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
        targetPos = ray.Origin + (ray.Direction * 300)
    end

    local proj = object.AssemblyRootPart or object
    releaseObject()

    proj.Anchored = false
    pcall(function()
        proj.CustomPhysicalProperties = PhysicalProperties.new(100, 0.5, 0.1, 1, 1)
    end)
    applyThrowPhase(proj, 2.0)

    local att = Instance.new("Attachment")
    att.Parent = proj
    local lv = Instance.new("LinearVelocity")
    lv.MaxForce = math.huge
    lv.VectorVelocity = Vector3.zero
    lv.Attachment0 = att
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    lv.Parent = proj

    task.spawn(function()
        local startTime = tick()
        while proj and proj.Parent and (tick() - startTime < 2.0) do
            local currentDest = (targetPart and targetPart.Parent and targetPart.Position) or targetPos
            local diff = currentDest - proj.Position
            if diff.Magnitude < 4 then break end
            lv.VectorVelocity = diff.Unit * Config.SnipeVelocity
            task.wait()
        end
        if lv then lv:Destroy() end
        if att then att:Destroy() end
    end)
end

local function toggleFreeze()
    if not object then return end
    local root = object.AssemblyRootPart or object
    if frozenRoot == root then
        root.Anchored = false
        frozenRoot = nil
        ObjectHighlight.FillColor = C.accent2
    else
        root.Anchored = true
        frozenRoot = root
        ObjectHighlight.FillColor = C.red
    end
    updateStatus()
end

-- Orbit runs in its OWN loop so it survives button release
task.spawn(function()
    while true do
        if orbitActive then
            local obj = object
            local char = LocalPlayer.Character
            if obj and obj.Parent and char and char:FindFirstChild("HumanoidRootPart") then
