-- TARGETING & COLLISION HELPERS
---------------------------------------------------------
local function setAssemblyCollision(rootPart, canCollide)
    if not rootPart then return end
    local parts = {}
    if rootPart.AssemblyRootPart then
        parts = rootPart.AssemblyRootPart:GetConnectedParts(true)
    else
        table.insert(parts, rootPart)
    end
    for _, p in ipairs(parts) do
        if p:IsA("BasePart") then p.CanCollide = canCollide end
    end
end

local function applyThrowPhase(rootPart, duration)
    local mode = NoclipModes[Config.NoclipModeIndex]
    if mode == "DISABLED" then
        setAssemblyCollision(rootPart, true)
        return
    end
    if mode == "ALWAYS" or mode == "UPON THROW" then
        setAssemblyCollision(rootPart, false)
        task.spawn(function()
            local startTime = tick()
            while (tick() - startTime < (duration or 2.5)) and rootPart and rootPart.Parent do
                setAssemblyCollision(rootPart, false)
                task.wait(0.1)
            end
            if mode ~= "ALWAYS" and rootPart and rootPart.Parent then
                setAssemblyCollision(rootPart, true)
            end
        end)
    elseif mode == "UPON HOLD" then
        setAssemblyCollision(rootPart, true)
    end
end

local function getHoveredPlayer()
    local mousePos = UserInputService:GetMouseLocation()
    local ray = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, object}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, rayParams)
    if result and result.Instance then
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChildOfClass("Humanoid") and model ~= LocalPlayer.Character then
            return model
        end
    end

    local bestChar, bestDist = nil, 140
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local d2 = (Vector2.new(mousePos.X, mousePos.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                if d2 < bestDist then
                    bestDist = d2
                    bestChar = player.Character
                end
            end
        end
    end
    return bestChar
end

