-- PICK PHASE: grab the object under the crosshair
---------------------------------------------------------
local function startHold()
    if mousedown then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Telekinesis") then return end
    local tool = char:FindFirstChild("Telekinesis")
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end

    mousedown = true
    updateStatus()

    local deadline = tick() + 0.75
    while mousedown and tick() < deadline do
        if Mouse.Target ~= nil then
            local target = Mouse.Target
            if not target.Anchored
                and not target:IsDescendantOf(char)
                and not target:IsA("Terrain") then
                object = target
                dist = math.max((object.Position - handle.Position).Magnitude, 5)
                ObjectHighlight.Adornee = object
                ObjectHighlight.Enabled = true

                local mode = NoclipModes[Config.NoclipModeIndex]
                if mode == "UPON HOLD" or mode == "ALWAYS" then
                    setAssemblyCollision(object, false)
                end
                updateStatus()
                return
            end
        end
        task.wait()
    end
end

