---------------------------------------------------------
local function toggleNet(enable)
    Config.SimRadiusEnabled = enable
    if enable then
        if not simConnection then
            simConnection = RunService.RenderStepped:Connect(function()
                pcall(function()
                    settings().Physics.AllowSleep = false
                    if setHidden then
                        setHidden(LocalPlayer, "SimulationRadius", math.huge)
                        setHidden(LocalPlayer, "MaxSimulationRadius", math.huge)
                    end
                    LocalPlayer.MaximumSimulationRadius = math.huge
                    LocalPlayer.ReplicationFocus = workspace
                end)
            end)
        end
    else
        if simConnection then
            simConnection:Disconnect()
            simConnection = nil
            pcall(function()
                if setSimRadius then
                    setSimRadius(139, 139)
                elseif setHidden then
                    setHidden(LocalPlayer, "MaximumSimulationRadius", 139)
                    setHidden(LocalPlayer, "SimulationRadius", 139)
                end
            end)
        end
    end
    if updateSimRadiusBtnUI then updateSimRadiusBtnUI() end
end

