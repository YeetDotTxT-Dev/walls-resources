                local root = char.HumanoidRootPart
                local offset = Vector3.new(math.cos(orbitAngle) * Config.OrbitRadius, 2, math.sin(orbitAngle) * Config.OrbitRadius)
                BP.Parent = obj
                BP.Position = root.Position + offset
            end
        end
        task.wait()
    end
end)

local function toggleOrbit()
    if not object then return end
    orbitActive = not orbitActive
    if orbitActive then
        if not mousedown then mousedown = true end -- keep object floating after release
        notify("ORBIT", "Enabled - object will float", 1.5)
    else
        if not mousedown then
            releaseObject() -- button already released -> drop
        end
    end
    updateStatus()
end

local function toggleSpin()
    if not object then return end
    local root = object.AssemblyRootPart or object
    if spinActive then
        if spinAV then spinAV:Destroy() spinAV = nil end
        spinActive = false
        root.AssemblyAngularVelocity = Vector3.zero
    else
        spinAV = Instance.new("BodyAngularVelocity")
        spinAV.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        spinAV.AngularVelocity = Vector3.new(0, 15, 0)
        spinAV.Parent = root
        spinActive = true
    end
    updateStatus()
end

local function toggleLock()
    if not object then return end
    local root = object.AssemblyRootPart or object
    if lockActive then
        if lockGyro then lockGyro:Destroy() lockGyro = nil end
        lockActive = false
    else
        lockGyro = Instance.new("BodyGyro")
        lockGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        lockGyro.D = 300
        lockGyro.P = 9000
        lockGyro.CFrame = root.CFrame
        lockGyro.Parent = root
        lockActive = true
    end
end

local function recallObject()
    if not object then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local obj = object
    local startPos = obj.Position
    local startTime = tick()
    recalling = true
    task.spawn(function()
        while recalling and obj and obj.Parent and (tick() - startTime < 1.5) do
            local t = (tick() - startTime) / 1.5
            BP.Parent = obj
            BP.Position = startPos:Lerp(root.Position + Vector3.new(0, 3, 0), t)
            task.wait()
        end
        recalling = false
    end)
end

local function magnetPull()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local radius, pulled = Config.MagnetRadius, 0

    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not v.Anchored and v.CanCollide then
            local isSelf = false
            if LocalPlayer.Character then
                isSelf = v:IsDescendantOf(LocalPlayer.Character)
            end
            if not isSelf and v ~= object then
                local d = (v.Position - root.Position).Magnitude
                if d <= radius and v.AssemblyLinearVelocity.Magnitude < 5 then
                    v.AssemblyLinearVelocity = (root.Position - v.Position).Unit * 80
                    pulled = pulled + 1
                end
            end
        end
    end
    notify("MAGNET PULL", "Pulled " .. pulled .. " object(s)", 2)
end

local function resetRotation()
    if not object then return end
    local root = object.AssemblyRootPart or object
    local startTime = tick()

    local BG = Instance.new("BodyGyro")
    BG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BG.D = 300
    BG.P = 12000
    BG.CFrame = CFrame.new(root.Position)
    BG.Parent = root

    task.spawn(function()
        while BG.Parent and (tick() - startTime < 1.5) do
            task.wait()
        end
        BG:Destroy()
        if root and root.Parent then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

