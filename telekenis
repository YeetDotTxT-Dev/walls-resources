local function matchesInput(input, boundVal)
    if not boundVal then return false end
    if typeof(boundVal) == "EnumItem" then
        if boundVal.EnumType == Enum.KeyCode then
            return input.KeyCode == boundVal
        elseif boundVal.EnumType == Enum.UserInputType then
            return input.UserInputType == boundVal
        end
    end
    return false
end

local function isGrabInput(input)
    return matchesInput(input, Keybinds.Grab)
end

