UserInputService.InputBegan:Connect(function(input)
    if not isBindingKey then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == Enum.KeyCode.Escape then
            isBindingKey = nil
            return
        end
        Keybinds[isBindingKey] = input.KeyCode
    elseif input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.MouseButton2
        or input.UserInputType == Enum.UserInputType.MouseButton3 then
        Keybinds[isBindingKey] = input.UserInputType
    else
        return
    end

    local boundId = isBindingKey
    isBindingKey = nil

    for k, v in pairs(Keybinds) do
        if k ~= boundId and v == Keybinds[boundId] then
            notify("WARN", "Duplicate bind on '" .. k .. "'", 3)
            break
        end
    end

    keybindButtons[boundId].Text = getKeyName(Keybinds[boundId])
    keybindButtons[boundId].TextColor3 = C.accent
    if mainLabels[boundId] then mainLabels[boundId]() end
end)

