RunService.RenderStepped:Connect(function()
    if not mousedown or not object then return end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Telekinesis") then return end
    local handle = char:FindFirstChild("Telekinesis"):FindFirstChild("Handle")
    if not handle then return end

    if object.Parent == nil then
        releaseObject()
        return
    end

    local root = object.AssemblyRootPart or object

    -- Clear stale frozen state if the assembly got unanchored externally
    if frozenRoot == root and not root.Anchored then
        frozenRoot = nil
        ObjectHighlight.FillColor = C.accent2
    end

    if not orbitActive then
        local look = CFrame.new(handle.Position, Mouse.Hit.Position)
        BP.Parent = root
        BP.Position = handle.Position + look.LookVector * dist
    end

    -- Keep rotation lock gyro refreshed to current orientation
    if lockActive and lockGyro and lockGyro.Parent then
        lockGyro.CFrame = root.CFrame
    end

    -- Noclip upkeep
    local mode = NoclipModes[Config.NoclipModeIndex]
    if mode == "UPON HOLD" or mode == "ALWAYS" then
        setAssemblyCollision(root, false)
    end
end)

