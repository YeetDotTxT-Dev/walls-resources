UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or isBindingKey then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Telekinesis") then return end

    if isGrabInput(input) then
        grabHeld = true
        startHold()
    elseif matchesInput(input, Keybinds.PullCloser) then
        if dist >= 5 then dist = dist - 10 end
    elseif matchesInput(input, Keybinds.PushFurther) then
        dist = dist + 10
    elseif matchesInput(input, Keybinds.Freeze) then
        toggleFreeze()
    elseif matchesInput(input, Keybinds.Orbit) then
        toggleOrbit()
    elseif matchesInput(input, Keybinds.Spin) then
        toggleSpin()
    elseif matchesInput(input, Keybinds.LockRotation) then
        toggleLock()
    elseif matchesInput(input, Keybinds.Recall) then
        recallObject()
    elseif matchesInput(input, Keybinds.Throw) then
        throwObject(Config.ThrowVelocity)
    elseif matchesInput(input, Keybinds.Launch) then
        throwObject(Config.LaunchVelocity)
    elseif matchesInput(input, Keybinds.Snipe) or matchesInput(input, Keybinds.SnipeMouse) then
        snipePlayer()
    elseif matchesInput(input, Keybinds.ResetRotation) then
        resetRotation()
    elseif matchesInput(input, Keybinds.MagnetPull) then
        magnetPull()
    elseif matchesInput(input, Keybinds.ToggleSimRadius) then
        toggleNet(not Config.SimRadiusEnabled)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if isGrabInput(input) then
        grabHeld = false
        if not orbitActive then
            releaseObject()
        end
    end
end)

