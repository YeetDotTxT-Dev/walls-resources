local function bindTooltip(guiElement, text)
    guiElement.MouseEnter:Connect(function()
        TooltipLabel.Text = text
        local ts = TextService:GetTextSize(text, 11, Enum.Font.Code, Vector2.new(215, 1000))
        TooltipFrame.Size = UDim2.new(0, 230, 0, math.clamp(ts.Y + 16, 40, 120))
        TooltipScroll.CanvasSize = UDim2.new(0, 0, 0, ts.Y + 6)
        TooltipFrame.Visible = true
    end)
    guiElement.MouseLeave:Connect(function()
        TooltipFrame.Visible = false
    end)
end

RunService.RenderStepped:Connect(function()
    if TooltipFrame.Visible then
        local mp = UserInputService:GetMouseLocation()
        local vs = Camera.ViewportSize
        TooltipFrame.Position = UDim2.new(0,
            math.clamp(mp.X + 16, 0, vs.X - 240),
            0, math.clamp(mp.Y + 16, 0, vs.Y - TooltipFrame.AbsoluteSize.Y - 8))
    end
end)

