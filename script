-- Fly Engine
local flyVelocity, flyGyro

local function stopFly()
    if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
    if flyGyro then flyGyro:Destroy(); flyGyro = nil end
    local _, _, hum = getCharParts()
    if hum then hum.PlatformStand = false end
end

local function startFly()
    stopFly()
    local _, hrp, hum = getCharParts()
    if not hrp or not hum then return end

    hum.PlatformStand = true

    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyVelocity.Velocity = Vector3.zero
    flyVelocity.Parent = hrp

    flyGyro = Instance.new("BodyGyro")
    flyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    flyGyro.CFrame = hrp.CFrame
    flyGyro.Parent = hrp
end

-- RenderStepped Loop (Aim Assist, Fly, Crosshair)
RunService.RenderStepped:Connect(function()
    -- FOV Circle
    if FOVCircle then
        FOVCircle.Visible = ESPConfig.ShowFOV and ESPConfig.AimAssist
        FOVCircle.Position = UserInputService:GetMouseLocation()
        FOVCircle.Radius = ESPConfig.AimFOV
    end

    -- Crosshair Projection
    if CrosshairDot then
        if ESPConfig.Crosshair then
            local barrel = getBarrel()
            local targetScreenPos = nil

            if barrel then
                local barrelCF = nil
                if barrel:IsA("Attachment") then
                    barrelCF = barrel.WorldCFrame
                elseif barrel:IsA("BasePart") then
                    barrelCF = barrel.CFrame
                elseif (barrel:IsA("DataModelMesh") or barrel:IsA("Mesh")) and barrel.Parent and barrel.Parent:IsA("BasePart") then
                    barrelCF = barrel.Parent.CFrame
                end

                if barrelCF then
                    local origin = barrelCF.Position
                    local direction = barrelCF.LookVector * 1000
                    local params = RaycastParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    params.FilterDescendantsInstances = {LocalPlayer.Character}

                    local result = workspace:Raycast(origin, direction, params)
                    local hitPos = result and result.Position or (origin + direction)
                    local screenPos, onScreen = Camera:WorldToViewportPoint(hitPos)
                    if onScreen then
                        targetScreenPos = Vector2.new(screenPos.X, screenPos.Y)
                    end
                end
            end

            if not targetScreenPos then
                local viewport = Camera.ViewportSize
                targetScreenPos = Vector2.new(viewport.X / 2, viewport.Y / 2)
            end

            CrosshairDot.Position = targetScreenPos
            CrosshairDot.Radius = ESPConfig.CrosshairSize
            CrosshairDot.Visible = true
        else
            CrosshairDot.Visible = false
        end
    end

    -- Aim Assist
    if ESPConfig.AimAssist then
        local isPressed = false
        if ESPConfig.AimKey.EnumType == Enum.UserInputType then
            isPressed = UserInputService:IsMouseButtonPressed(ESPConfig.AimKey)
        else
            isPressed = UserInputService:IsKeyDown(ESPConfig.AimKey)
        end

        if isPressed then
            local targetPart = getClosestPlayer()
            if targetPart then
                local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, ESPConfig.AimSmoothness)
            end
        end
    end

    -- Fly Physics
    if ESPConfig.Fly then
        local _, hrp, hum = getCharParts()
        if not hrp or not hum then
            stopFly()
            return
        end

        if not flyVelocity or not flyGyro then
            startFly()
        end

        flyGyro.CFrame = Camera.CFrame

        local moveDir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDir = moveDir + Camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDir = moveDir - Camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDir = moveDir - Camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDir = moveDir + Camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveDir = moveDir + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            moveDir = moveDir - Vector3.new(0, 1, 0)
        end

        if moveDir.Magnitude > 0 then
            flyVelocity.Velocity = moveDir.Unit * ESPConfig.FlySpeed
        else
            flyVelocity.Velocity = Vector3.zero
        end
    else
        if flyVelocity or flyGyro then
            stopFly()
        end
    end
end)

