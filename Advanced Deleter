-- Render Inspector Data for a Target Object
local function displayInspectorData(target)
    if not target then return end

    -- Clear old property rows
    for _, child in ipairs(InspContent:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    InspectorFrame.Visible = true

    -- Format properties safely
    addPropertyRow("Name", target.Name)
    addPropertyRow("ClassName", target.ClassName)
    addPropertyRow("Path", target:GetFullName())

    if target:IsA("BasePart") then
        addPropertyRow("Anchored", target.Anchored)
        addPropertyRow("CanCollide", target.CanCollide)
        addPropertyRow("Transparency", math.floor(target.Transparency * 100) / 100)
        addPropertyRow("Material", target.Material.Name)
        addPropertyRow("Color", string.format("RGB(%d, %d, %d)", target.Color.R * 255, target.Color.G * 255, target.Color.B * 255))
        addPropertyRow("Size", string.format("%.1f, %.1f, %.1f", target.Size.X, target.Size.Y, target.Size.Z))
        addPropertyRow("Position", string.format("%.1f, %.1f, %.1f", target.Position.X, target.Position.Y, target.Position.Z))
    elseif target:IsA("Model") then
        local cf, size = target:GetBoundingBox()
        addPropertyRow("Pivot Position", string.format("%.1f, %.1f, %.1f", cf.Position.X, cf.Position.Y, cf.Position.Z))
        addPropertyRow("Model Size", string.format("%.1f, %.1f, %.1f", size.X, size.Y, size.Z))
        if target.PrimaryPart then
            addPropertyRow("PrimaryPart", target.PrimaryPart.Name)
        end
    end

    addPropertyRow("Child Count", #target:GetChildren())
    addPropertyRow("Parent", target.Parent and target.Parent.Name or "None")
end

