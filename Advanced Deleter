-- Hover Render Loop
RunService.RenderStepped:Connect(function()
    if not ScreenGui.Enabled then
        SelectionHighlight.Adornee = nil
        return
    end

    local target = Mouse.Target
    if target then
        if isProtected(target) then
            TargetInfo.Text = "Target: [PROTECTED] " .. target.Name
            TargetInfo.TextColor3 = Color3.fromRGB(255, 100, 100)
            SelectionHighlight.FillColor = Color3.fromRGB(255, 0, 0)
        else
            TargetInfo.Text = "Target: " .. target.Name .. " (" .. target.ClassName .. ")"
            TargetInfo.TextColor3 = Color3.fromRGB(100, 220, 100)
            SelectionHighlight.FillColor = Color3.fromRGB(50, 255, 50)
        end

        if ToolState.Mode == "Model" and target.Parent and target.Parent:IsA("Model") and target.Parent ~= Workspace then
            SelectionHighlight.Adornee = target.Parent
        else
            SelectionHighlight.Adornee = target
        end
    else
        TargetInfo.Text = "Target: None"
        SelectionHighlight.Adornee = nil
    end
end)

-- Function to create and manage the tool across respawns
local function giveTool()
    local backpack = LocalPlayer:WaitForChild("Backpack")

    -- Check if player already has the tool in backpack or character
    if backpack:FindFirstChild("Advanced Destroyer") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Advanced Destroyer")) then
        return
    end

    local Tool = Instance.new("Tool")
    Tool.Name = "Advanced Destroyer"
    Tool.RequiresHandle = false

    Tool.Equipped:Connect(function()
        ScreenGui.Enabled = true
    end)

    Tool.Unequipped:Connect(function()
        ScreenGui.Enabled = false
        InspectorFrame.Visible = false
        SelectionHighlight.Adornee = nil
    end)

    Tool.Activated:Connect(function()
        local target = Mouse.Target
        if not target then return end

        if ToolState.Mode == "Single" then
            deleteSafely(target)

        elseif ToolState.Mode == "Model" then
            local model = target:FindFirstAncestorOfClass("Model") or target
            if model and model ~= Workspace then
                deleteSafely(model)
            else
                deleteSafely(target)
            end

        elseif ToolState.Mode == "Radius" then
            local hitPos = Mouse.Hit.Position
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Position - hitPos).Magnitude <= ToolState.Radius then
                    deleteSafely(obj)
                end
            end

        elseif ToolState.Mode == "ClassFilter" then
            if ToolState.FilterType == "Decals & Textures" then
                for _, child in ipairs(target:GetChildren()) do
                    if child:IsA("Decal") or child:IsA("Texture") then
                        deleteSafely(child)
                    end
                end
            elseif ToolState.FilterType == "Lights & Sounds" then
                for _, child in ipairs(target:GetChildren()) do
                    if child:IsA("Light") or child:IsA("Sound") then
                        deleteSafely(child)
                    end
                end
            elseif ToolState.FilterType == "MeshParts & SpecialMeshes" then
                if target:IsA("MeshPart") then
                    deleteSafely(target)
                else
                    for _, child in ipairs(target:GetChildren()) do
                        if child:IsA("SpecialMesh") then
                            deleteSafely(child)
                        end
                    end
                end
            end

        elseif ToolState.Mode == "Inspector" then
            displayInspectorData(target)
        end
    end)

    Tool.Parent = backpack
end

-- Give tool on execution
giveTool()

-- Restore tool automatically whenever player respawns
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    giveTool()
end)

-- Keyboard Shortcuts
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not ScreenGui.Enabled then return end

    if input.KeyCode == Enum.KeyCode.Z then
        performUndo()
    elseif input.KeyCode == Enum.KeyCode.E then
        cycleMode()
    end
end)
