-- Whitelist Inspector
local function isProtected(target)
    if not target then return true end

    -- Check Terrain / Baseplate
    if ToolState.ProtectTerrain and (target:IsA("Terrain") or target.Name == "Baseplate") then
        return true
    end

    -- Check Players
    if ToolState.ProtectPlayers then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and target:IsDescendantOf(p.Character) then
                return true
            end
        end
    end

    -- Check Props folder
    if ToolState.ProtectProps then
        local propsFolder = Workspace:FindFirstChild("props")
        if propsFolder and (target == propsFolder or target:IsDescendantOf(propsFolder)) then
            return true
        end
    end

    return false
end

-- Update Stack Counter Text
local function updateUndoText()
    UndoBtn.Text = "Undo Last Delete (Stack: " .. tostring(#ToolState.UndoStack) .. ") [Z]"
end

-- Save Instance to Undo Stack and Remove
local function deleteSafely(target)
    if isProtected(target) then return false end

    local oldParent = target.Parent
    target.Parent = UndoStorage

    table.insert(ToolState.UndoStack, {
        Instance = target,
        OriginalParent = oldParent
    })

    updateUndoText()
    return true
end

-- Undo Action
local function performUndo()
    if #ToolState.UndoStack > 0 then
        local lastData = table.remove(ToolState.UndoStack)
        if lastData and lastData.Instance then
            lastData.Instance.Parent = lastData.OriginalParent or Workspace
            updateUndoText()
        end
    end
end

-- Cycle Tool Modes
local modes = { "Single", "Model", "Radius", "ClassFilter", "Inspector" }
local function cycleMode()
    local currentIndex = table.find(modes, ToolState.Mode) or 1
    local nextIndex = (currentIndex % #modes) + 1
    ToolState.Mode = modes[nextIndex]

    if ToolState.Mode == "Single" then
        ModeBtn.Text = "Mode: Single Part [Click to Switch]"
        ConfigBtn.Text = "Target: Individual Clicked Part"
    elseif ToolState.Mode == "Model" then
        ModeBtn.Text = "Mode: Entire Model/Assembly"
        ConfigBtn.Text = "Target: Parent Model Container"
    elseif ToolState.Mode == "Radius" then
        ModeBtn.Text = "Mode: Radius Explosion"
        ConfigBtn.Text = "Radius: " .. tostring(ToolState.Radius) .. " studs [Click to Change]"
    elseif ToolState.Mode == "ClassFilter" then
        ModeBtn.Text = "Mode: Class Filter"
        ConfigBtn.Text = "Filter: " .. ToolState.FilterType .. " [Click to Cycle]"
    elseif ToolState.Mode == "Inspector" then
        ModeBtn.Text = "Mode: On-Screen Inspector"
        ConfigBtn.Text = "Click target to inspect properties"
    end
end

-- Mode Button Handler
